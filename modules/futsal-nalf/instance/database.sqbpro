ALTER TABLE game_events RENAME COLUMN record_time TO replay_end_time;
ALTER TABLE game_events ADD COLUMN replay_start_time INTEGER;

UPDATE game_events
SET replay_start_time = CASE
    WHEN replay_end_time IS NULL THEN NULL
    WHEN replay_end_time &lt; 10000 THEN 0
    ELSE replay_end_time - 10000
END;

-- Tabela event_cameras
ALTER TABLE event_cameras RENAME COLUMN record_time TO replay_end_time;
ALTER TABLE event_cameras ADD COLUMN replay_start_time INTEGER;

UPDATE event_cameras
SET replay_start_time = CASE
    WHEN replay_end_time &lt; 10000 THEN 0
    ELSE replay_end_time - 10000
END;</sql><current_tab id="0"/></tab_sql></sqlb_project>
