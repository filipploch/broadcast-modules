      "device_path": "/dev/camera2",
      "loopback_device": "/dev/video12",
      "service_name": "recorder-camera2.service",
      "enabled": true
    },
    {
      "id": "camera3",
      "device_name": "camera3",
      "device_path": "/dev/camera3",
      "loopback_device": "/dev/video13",
      "service_name": "recorder-camera3.service",
