[Unit]
Description=Broadcast Recorder Plugin
Documentation=https://github.com/your-org/broadcast-modules
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/recorder-plugin/recorder-plugin
WorkingDirectory=/opt/recorder-plugin

# Path to config file (overrides default "config.json" in WorkingDirectory)
Environment=CONFIG_PATH=/opt/recorder-plugin/config.json

Restart=always
RestartSec=5s

# Allow recorder-plugin to call systemctl (requires root or a polkit rule)
# If running as non-root, add a sudoers/polkit rule for systemctl start/stop
# of recorder-cameraN.service units.
# User=recorder

StandardOutput=journal
StandardError=journal
SyslogIdentifier=recorder-plugin

[Install]
WantedBy=multi-user.target
