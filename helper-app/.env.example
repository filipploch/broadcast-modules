SECRET_KEY=change-me
DATABASE_URL=sqlite:///helper_app.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
FLASK_APP=run.py
FLASK_DEBUG=1

# Token dla lekkiego kanału REST wywoływanego wychodząco przez moduł główny
